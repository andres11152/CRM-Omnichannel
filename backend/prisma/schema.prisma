enum MediaAssetType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model MediaAsset {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // File metadata
  filename     String // "video-bienvenida.mp4"
  originalName String // Nombre original al subir
  mimeType     String // "video/mp4", "image/jpeg"
  fileSize     Int // Bytes
  type         MediaAssetType

  // URLs (Cloudinary/S3)
  fileUrl      String // URL del archivo original
  thumbnailUrl String? // Thumbnail/preview (solo para video/imagen)

  // Cloudinary metadata
  cloudinaryPublicId String? // Para poder eliminar de Cloudinary

  // Organización
  category    String? // "Marketing", "Soporte", "Ventas"
  description String?
  tags        String[] @default([]) // ["onboarding", "promoción"]

  // Metadata adicional (para imágenes/videos)
  width    Int? // Pixels
  height   Int? // Pixels
  duration Int? // Segundos (para videos/audios)

  // Auditoría
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, type])
  @@index([companyId, category])
  @@index([uploadedById])
  @@map("media_assets")
}

// ========================================
// EMAIL MODULE
// ========================================

enum EmailStatus {
  QUEUED // En cola para envío
  SENT // Enviado exitosamente
  DELIVERED // Confirmado entregado (webhook)
  OPENED // Email abierto (tracking pixel)
  CLICKED // Link clickeado
  BOUNCED // Rebotado (email inválido)
  FAILED // Fallo al enviar
  SPAM // Marcado como spam
}

enum EmailType {
  INBOUND // Email recibido
  OUTBOUND // Email enviado
}

model Email {
  id String @id @default(cuid())

  // Company isolation (multi-tenancy)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Provider message ID (para tracking de webhooks)
  messageId String? @unique // SendGrid/SES message ID

  // Email metadata
  subject  String
  bodyHtml String  @db.Text // HTML body
  bodyText String? @db.Text // Plain text fallback

  // Sender/Receiver
  from    String // email@example.com
  to      String[] // Array de destinatarios
  cc      String[] @default([])
  bcc     String[] @default([])
  replyTo String?

  // Status tracking
  status EmailStatus @default(QUEUED)
  type   EmailType

  // Relations
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  // Links this raw Email row to its EMAIL-channel Conversation (so the full
  // HTML body / attachments are preserved alongside the lightweight Message
  // shown in the agent chat thread).
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Links a campaign-triggered send back to its Campaign, for open/click/
  // bounce reporting per campaign.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // RFC 5322 In-Reply-To header of the inbound mail — set on outbound replies
  // so the recipient's mail client threads the conversation correctly.
  inReplyTo String?

  // Attachments (JSON array of Media IDs or URLs)
  attachments Json? // [{ filename: 'doc.pdf', url: 's3://...' }]

  // Tracking metadata
  openedAt  DateTime? // Cuando se abrió
  clickedAt DateTime? // Cuando se hizo click

  // Error handling
  errorMessage String?
  retryCount   Int     @default(0)

  // Timestamps
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Indexes for performance
  @@index([companyId, createdAt(sort: Desc)]) // Timeline queries
  @@index([contactId, createdAt(sort: Desc)]) // Contact timeline
  @@index([ticketId, createdAt(sort: Desc)]) // Ticket timeline
  @@index([conversationId, createdAt(sort: Desc)]) // Conversation → emails
  @@index([campaignId]) // Campaign report aggregation
  @@index([status]) // Status filtering
  @@index([messageId]) // Webhook lookups
  @@map("emails")
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  endpoint  String   @db.Text // Can be very long
  p256dh    String // Public key for push encryption
  auth      String // Auth secret for push encryption
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([companyId])
  @@map("push_subscriptions")
}

// ============================================
// RBAC - ROLE-BASED ACCESS CONTROL
// ============================================

// Permission Categories
enum PermissionModule {
  CONVERSATIONS // Gestión de conversaciones
  TICKETS // Gestión de tickets
  CONTACTS // Gestión de contactos
  DEALS // Gestión de deals/ventas
  ACTIVITIES // Gestión de actividades
  CAMPAIGNS // Campañas de marketing
  REPORTS // Reportes y analítica
  SETTINGS // Configuración
  TEAM // Gestión de equipo
  INTEGRATIONS // Integraciones
  MEDIA // Biblioteca multimedia
  FLOWS // Chatbot flows
  PRODUCTS // Catálogo de productos
  PROPERTIES // Módulo inmobiliario (propiedades)
  QUEUES // Gestión de colas
}

enum PermissionAction {
  VIEW // Ver/Leer
  CREATE // Crear
  EDIT // Editar
  DELETE // Eliminar
  ASSIGN // Asignar
  EXPORT // Exportar
  IMPORT // Importar
  MANAGE // Gestión completa
}

// Role model for custom roles
model Role {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String // "Agente de Ventas", "Supervisor", "Soporte L1"
  description String?
  isSystem    Boolean @default(false) // true for MASTER, ADMIN, AGENT (non-editable)
  isActive    Boolean @default(true)

  // Base role (for inheritance)
  baseRole UserRole @default(AGENT) // MASTER, ADMIN, AGENT

  // Relations
  permissions RolePermission[]
  users       User[]           @relation("UserRole")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("roles")
}

// Permission model
model Permission {
  id String @id @default(cuid())

  module      PermissionModule
  action      PermissionAction
  resource    String // Specific resource like "own_tickets", "all_tickets", "team_tickets"
  description String?

  // Relations
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())

  @@unique([module, action, resource])
  @@index([module])
  @@map("permissions")
}

// Junction table for Role-Permission (many-to-many)
model RolePermission {
  id String @id @default(cuid())

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Optional: Conditions (JSON for advanced rules)
  conditions Json? // { "department": "sales", "priority": "high" }

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String  @id @default(cuid())
  companyId String
  userId    String? // Nullable strictly for system actions or external webhooks
  action    String // CREATE, UPDATE, DELETE, LOGIN, EXPORT
  entity    String // Contact, Campaign, Ticket
  entityId  String
  details   Json? // { diff: { old: ..., new: ... }, meta: ... }
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// 🔔 NOTIFICATIONS MODEL
// In-app notifications for mentions, assignments, etc.
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🛡️ MULTI-TENANCY
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type    String // "mention", "assignment", "ticket_update", etc.
  title   String
  message String

  read Boolean @default(false)

  // Optional: Link to related resource
  link String? // e.g. "/tickets/123" or "/contacts/abc"

  // Optional: Metadata (JSON)
  metadata Json? // { activityId, createdBy, etc. }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("notifications")
}

// 💳 BILLING TRANSACTIONS (MASTER ADMIN)
// Stores history of SaaS charges to tenants
model BillingTransaction {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  description String
  amount      Int // Cents (USD/COP/MXN)
  currency    String @default("USD")
  status      String // succeeded, failed, refunded, pending

  invoiceId       String? @unique
  stripePaymentId String?

  billingDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // === ANALYTICS INDEXES ===
  // 1. "Revenue Today" query
  @@index([status, billingDate(sort: Desc)])
  // 2. Tenant billing history
  @@index([companyId, billingDate(sort: Desc)])
  @@map("billing_transactions")
}

model MeetingType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  duration    Int     @default(30)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@index([companyId])
  @@map("meeting_types")
}

model Availability {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  timezone String @default("America/Bogota")
  rules    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("availabilities")
}
