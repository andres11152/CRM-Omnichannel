{
  "apps": [
    {
      "name": "reply-crm-api",
      "script": "dist/server.js",
      "instances": "max",
      "exec_mode": "cluster",
      "node_args": [
        "--max-old-space-size=4096",
        "--max-semi-space-size=128",
        "--expose-gc"
      ],
      "env": {
        "NODE_ENV": "production",
        "PORT": 4000
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 4000
      },
      "env_development": {
        "NODE_ENV": "development",
        "PORT": 4000
      },
      "error_file": "./logs/pm2-error.log",
      "out_file": "./logs/pm2-out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "max_memory_restart": "3500M",
      "restart_delay": 4000,
      "kill_timeout": 5000,
      "listen_timeout": 3000,
      "shutdown_with_message": true,
      "wait_ready": true,
      "exp_backoff_restart_delay": 100,
      "watch": false,
      "ignore_watch": ["node_modules", "logs", "public"],
      "combine_logs": true,
      "time": true,
      "cron_restart": "0 3 * * *",
      "log_type": "json"
    }
  ]
}
