generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TestModel {
  id String @id
}

model User {
  id                                       String          @id
  email                                    String          @unique
  name                                     String?
  password                                 String
  createdAt                                DateTime        @default(now())
  updatedAt                                DateTime
  companyId                                String?
  role                                     UserRole        @default(AGENT)
  preferences                              Json?
  companies                                companies?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Participants                             Participants[]
  QueueAgents                              QueueAgents[]
  activities_activities_assignedToIdToUser activities[]    @relation("activities_assignedToIdToUser")
  activities_activities_createdByIdToUser  activities[]    @relation("activities_createdByIdToUser")
  conversations                            conversations[]
  deals                                    deals[]
  media                                    media[]
  messages                                 messages[]
  posts                                    posts[]
  replies                                  replies[]
  tickets_tickets_assignedToIdToUser       tickets[]       @relation("tickets_assignedToIdToUser")
  tickets_tickets_createdByIdToUser        tickets[]       @relation("tickets_createdByIdToUser")
}

model Participants {
  A             String
  B             String
  conversations conversations @relation(fields: [A], references: [id], onDelete: Cascade)
  User          User          @relation(fields: [B], references: [id], onDelete: Cascade)

  @@unique([A, B], map: "_Participants_AB_unique")
  @@index([B], map: "_Participants_B_index")
  @@map("_Participants")
}

model QueueAgents {
  A      String
  B      String
  queues queues @relation(fields: [A], references: [id], onDelete: Cascade)
  User   User   @relation(fields: [B], references: [id], onDelete: Cascade)

  @@unique([A, B], map: "_QueueAgents_AB_unique")
  @@index([B], map: "_QueueAgents_B_index")
  @@map("_QueueAgents")
}

model accounts {
  id         String       @id
  companyId  String
  name       String
  industry   String?
  website    String?
  size       String?
  address    String?
  status     String       @default("ACTIVE")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  email      String?
  companies  companies    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activities activities[]
  contacts   contacts[]
  deals      deals[]

  @@index([companyId])
}

model activities {
  id                                 String       @id
  companyId                          String
  type                               ActivityType @default(NOTE)
  subject                            String
  description                        String?
  status                             String       @default("PENDING")
  dueDate                            DateTime?
  accountId                          String?
  dealId                             String?
  contactId                          String?
  assignedToId                       String?
  createdById                        String
  createdAt                          DateTime     @default(now())
  updatedAt                          DateTime
  accounts                           accounts?    @relation(fields: [accountId], references: [id])
  User_activities_assignedToIdToUser User?        @relation("activities_assignedToIdToUser", fields: [assignedToId], references: [id])
  companies                          companies    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts                           contacts?    @relation(fields: [contactId], references: [id])
  User_activities_createdByIdToUser  User         @relation("activities_createdByIdToUser", fields: [createdById], references: [id])
  deals                              deals?       @relation(fields: [dealId], references: [id])

  @@index([companyId])
}

model ai_assistants {
  id            String    @id
  companyId     String
  name          String
  description   String?
  modelProvider String
  modelName     String
  systemPrompt  String
  temperature   Float     @default(0.7)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  companies     companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  queues        queues[]
}

model ai_configs {
  id        String    @id
  companyId String    @unique
  openaiKey String?
  geminiKey String?
  isActive  Boolean   @default(true)
  updatedAt DateTime
  companies companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model api_keys {
  id         String    @id
  keyHash    String    @unique
  keyPrefix  String
  name       String
  companyId  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  companies  companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model campaigns {
  id             String    @id
  companyId      String
  name           String
  templateId     String?
  messageContent String
  targetTags     String[]
  status         String    @default("draft")
  config         Json?
  stats          Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  channel        Channel   @default(WHATSAPP)
  subject        String?
  companies      companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model companies {
  id                   String              @id
  name                 String
  slug                 String?             @unique
  logoUrl              String?
  status               CompanyStatus       @default(TRIAL)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime
  subscriptionEndsAt   DateTime?
  planId               String?
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  User                 User[]
  accounts             accounts[]
  activities           activities[]
  ai_assistants        ai_assistants[]
  ai_configs           ai_configs?
  api_keys             api_keys[]
  campaigns            campaigns[]
  plans                plans?              @relation(fields: [planId], references: [id])
  contacts             contacts[]
  conversations        conversations[]
  deals                deals[]
  departments          departments[]
  media                media[]
  message_templates    message_templates[]
  queues               queues[]
  quick_replies        quick_replies[]
  tags                 tags[]
  tickets              tickets[]
  whatsapp_sessions    whatsapp_sessions[]
  workflows            workflows[]
}

model contacts {
  id           String       @id
  companyId    String
  name         String
  email        String?
  phone        String?
  avatarUrl    String?
  tags         String[]
  customFields Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  notes        String?
  accountId    String?
  activities   activities[]
  accounts     accounts?    @relation(fields: [accountId], references: [id])
  companies    companies    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deals        deals[]
}

model conversations {
  id           String             @id
  subject      String?
  status       ConversationStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime
  resolvedAt   DateTime?
  companyId    String
  assignedToId String?
  channelId    String?
  tags         String[]
  queueId      String?
  Participants Participants[]
  User         User?              @relation(fields: [assignedToId], references: [id], onDelete: NoAction)
  companies    companies          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  queues       queues?            @relation(fields: [queueId], references: [id])
  messages     messages[]
  tickets      tickets[]
}

model deals {
  id                String       @id
  companyId         String
  title             String
  value             Float        @default(0)
  currency          String       @default("USD")
  stage             DealStage    @default(NEW)
  probability       Int          @default(10)
  expectedCloseDate DateTime?
  accountId         String?
  contactId         String?
  assignedToId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  activities        activities[]
  accounts          accounts?    @relation(fields: [accountId], references: [id])
  User              User?        @relation(fields: [assignedToId], references: [id])
  companies         companies    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts          contacts?    @relation(fields: [contactId], references: [id])

  @@index([companyId])
  @@index([stage])
}

model departments {
  id        String    @id
  name      String
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime
  companies companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  queues    queues[]

  @@unique([companyId, name])
}

model media {
  id           String    @id
  companyId    String
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  key          String
  type         MediaType
  category     String?
  tags         String[]
  description  String?
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  companies    companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
  User         User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
  @@index([type])
  @@index([uploadedById])
}

model message_templates {
  id         String    @id
  companyId  String
  name       String
  language   String    @default("es")
  category   String    @default("MARKETING")
  status     String    @default("approved")
  components Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  channel    Channel   @default(WHATSAPP)
  subject    String?
  companies  companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model messages {
  id             String           @id
  content        String
  channel        Channel
  direction      MessageDirection
  createdAt      DateTime         @default(now())
  conversationId String
  senderId       String
  metadata       Json?
  conversations  conversations    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User             @relation(fields: [senderId], references: [id], onDelete: NoAction)
}

model plans {
  id        String      @id @unique
  name      String
  price     Float
  config    Json
  companies companies[]
}

model posts {
  id        String    @id
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime
  authorId  String
  User      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   replies[]
}

model queues {
  id            String          @id
  name          String
  description   String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  companyId     String
  departmentId  String?
  config        Json?
  type          QueueType       @default(MANUAL)
  aiAssistantId String?
  QueueAgents   QueueAgents[]
  conversations conversations[]
  ai_assistants ai_assistants?  @relation(fields: [aiAssistantId], references: [id])
  companies     companies       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments   departments?    @relation(fields: [departmentId], references: [id])
  tickets       tickets[]
}

model quick_replies {
  id        String    @id
  companyId String
  title     String
  content   String
  category  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  companies companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model replies {
  id        String   @id
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  authorId  String
  postId    String
  User      User     @relation(fields: [authorId], references: [id], onDelete: NoAction)
  posts     posts    @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model tags {
  id        String    @id
  name      String
  color     String
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime
  companies companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

model tickets {
  id                              String         @id
  subject                         String
  description                     String
  status                          TicketStatus   @default(OPEN)
  priority                        TicketPriority @default(MEDIUM)
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime
  resolvedAt                      DateTime?
  companyId                       String
  createdById                     String
  assignedToId                    String?
  queueId                         String?
  conversationId                  String?
  User_tickets_assignedToIdToUser User?          @relation("tickets_assignedToIdToUser", fields: [assignedToId], references: [id], onDelete: NoAction)
  companies                       companies      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations                   conversations? @relation(fields: [conversationId], references: [id])
  User_tickets_createdByIdToUser  User           @relation("tickets_createdByIdToUser", fields: [createdById], references: [id], onDelete: NoAction)
  queues                          queues?        @relation(fields: [queueId], references: [id])
}

model webhooks {
  id        String   @id
  companyId String
  url       String
  secretKey String?
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model workflow_executions {
  id          String    @id
  workflowId  String
  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  logs        Json?
  error       String?
  workflows   workflows @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model workflows {
  id                  String                @id
  companyId           String
  name                String
  description         String?
  isActive            Boolean               @default(true)
  triggerType         String                @default("KEYWORD")
  triggerConfig       Json?
  nodes               Json?
  edges               Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  workflow_executions workflow_executions[]
  companies           companies             @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

enum Channel {
  EMAIL
  WHATSAPP
  WEB_CHAT
  TELEGRAM
  FACEBOOK_MESSENGER
  INSTAGRAM_DM
  SMS
}

enum CompanyStatus {
  ACTIVE
  TRIAL
  OVERDUE
  CANCELED
  BANNED
  INACTIVE
}

enum ConversationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum QueueType {
  MANUAL
  ROUND_ROBIN
  AI
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UserRole {
  USER
  AGENT
  ADMIN
  MASTER
}

model whatsapp_sessions {
  id        String   @id @default(cuid())
  companyId String
  sessionId String   @unique
  phone     String?
  status    String   @default("DISCONNECTED")
  qrCode    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companies companies @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model whatsapp_credentials {
  id        String   @id @default(cuid())
  sessionId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, key])
}
