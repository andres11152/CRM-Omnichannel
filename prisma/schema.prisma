// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Define la fuente de datos.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 2. Define el generador del cliente.
generator client {
  provider = "prisma-client-js"
}

// --- Modelos de Soporte (Conversations) ---

enum Channel {
  EMAIL
  WHATSAPP
  WEB_CHAT
  TELEGRAM
  FACEBOOK_MESSENGER
  INSTAGRAM_DM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ConversationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Conversation {
  id         String             @id @default(cuid())
  subject    String?
  status     ConversationStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  resolvedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relación con participantes (muchos a muchos implícito)
  participants User[] @relation("Participants")

  // Agente asignado
  assignedToId String?
  assignedTo   User?   @relation("AssignedConversations", fields: [assignedToId], references: [id], onDelete: NoAction)

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  content        String
  channel        Channel
  direction      MessageDirection
  createdAt      DateTime         @default(now())

  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Remitente del mensaje
  senderId       String
  sender         User             @relation("SenderMessages", fields: [senderId], references: [id], onDelete: NoAction)

  @@map("messages")
}

// --- Modelos de Autenticación y SaaS Multi-Tenant ---

enum UserRole {
  USER
  AGENT
  ADMIN
  MASTER
}

enum CompanyStatus {
  ACTIVE
  TRIAL
  OVERDUE
  CANCELED
  BANNED
}

model Company {
  id                    String          @id @default(cuid())
  name                  String
  slug                  String?         @unique
  logoUrl               String?
  status                CompanyStatus   @default(TRIAL)
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  subscriptionEndsAt    DateTime?

  // Relaciones
  users                 User[]
  tickets               Ticket[]
  apiKeys               ApiKey[]       
  conversations         Conversation[] // <--- RELACIÓN A CONVERSACIONES

  // Relación con Stripe y Planes
  planId                String?
  plan                  Plan?           @relation(fields: [planId], references: [id])
  stripeCustomerId      String?         @unique
  stripeSubscriptionId  String?         @unique

  @@map("companies")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  password        String
  role            UserRole  @default(AGENT)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relación con Compañía (Tenant)
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relaciones del foro/blog
  posts           Post[] // Posts creados por el usuario
  replies         Reply[] // Respuestas creadas por el usuario

  // Relaciones de Tickets
  createdTickets  Ticket[]  @relation("CreatedTickets")
  assignedTickets Ticket[]  @relation("AssignedTickets")

  // Relaciones de Conversaciones (Mensajería)
  sentMessages    Message[]      @relation("SenderMessages") // Mensajes que el usuario envió
  assignedConversations Conversation[] @relation("AssignedConversations") // Conversaciones asignadas al agente
  conversations   Conversation[] @relation("Participants") // Conversaciones donde participa
}

model Plan {
  id        String    @id @unique
  name      String
  price     Float
  config    Json      // { max_users: number; max_queues: number; }
  companies Company[]

  @@map("plans")
}

model ApiKey {
  id          String    @id @default(cuid())
  keyHash     String    @unique // Hash de la clave, nunca la clave en texto plano
  keyPrefix   String    // Prefijo no sensible para identificación (ej. "sk_live_...")
  name        String    // Un nombre descriptivo dado por el usuario
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime? // Opcional: para rastrear el uso

  @@map("api_keys")
}

// --- Modelos del Foro/Blog ---

model Post {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  authorId String
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies Reply[]

  @@map("posts")
}

model Reply {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  authorId String
  author   User     @relation(fields: [authorId], references: [id], onDelete: NoAction)

  postId String
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("replies")
}

// --- Modelos de Soporte (Tickets) ---

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id            String          @id @default(cuid())
  subject       String
  description   String
  status        TicketStatus    @default(OPEN)
  priority      TicketPriority  @default(MEDIUM)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  resolvedAt    DateTime?

  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User            @relation("CreatedTickets", fields: [createdById], references: [id], onDelete:NoAction)
  assignedToId  String?
  assignedTo    User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: NoAction)

  @@map("tickets")
}