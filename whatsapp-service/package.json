{
  "name": "whatsapp-service",
  "version": "1.0.0",
  "description": "WhatsApp socket management microservice using Baileys",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf dist && tsc",
    "start": "node -r module-alias/register dist/server.js",
    "prisma:generate": "npx prisma generate"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node-cache": "^4.1.3",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "baileys-antiban": "^4.10.0",
    "bullmq": "^5.67.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^5.9.2",
    "libphonenumber-js": "^1.13.9",
    "module-alias": "^2.2.3",
    "node-cache": "^5.1.2",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "redis": "^6.1.0",
    "socks-proxy-agent": "^8.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
