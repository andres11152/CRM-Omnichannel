// --- CRM Models ---

// Pipeline model for dynamic, tenant-specific sales pipelines
model Pipeline {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)

  stages Stage[]
  deals  Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure each company can have only one default pipeline
  @@unique([companyId, isDefault])
  @@index([companyId, isDefault])
  @@map("pipelines")
}

// Stage model for dynamic pipeline stages
model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name  String
  order Float   @default(0) // Float for flexible drag-and-drop reordering
  color String? @default("#6B7280") // Hex color for UI customization

  // [SALES] Semantic outcome flags — analytics must never infer "won"/"lost"
  // from stage.name (a client-renameable string). Exactly one of these
  // should be true for a closing stage; both false means the deal is open.
  isWon  Boolean @default(false)
  isLost Boolean @default(false)

  deals                Deal[]
  dealStageHistoryFrom DealStageHistory[] @relation("DealStageHistoryFrom")
  dealStageHistoryTo   DealStageHistory[] @relation("DealStageHistoryTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, order])
  @@index([pipelineId, order])
  @@map("stages")
}

// [SALES] Append-only log of deal stage transitions — the source of truth
// for sales velocity, per-stage conversion, and historical pipeline
// snapshots. Written once per transition, never updated or deleted.
model DealStageHistory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   Stage?  @relation("DealStageHistoryFrom", fields: [fromStageId], references: [id], onDelete: SetNull)

  toStageId String?
  toStage   Stage?  @relation("DealStageHistoryTo", fields: [toStageId], references: [id], onDelete: SetNull)

  valueAtChange Float

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  changedAt DateTime @default(now())

  @@index([companyId, changedAt])
  @@index([dealId, changedAt])
  @@map("deal_stage_history")
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

model Account {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  industry  String?
  website   String?
  email     String?
  size      String? // e.g. "1-10", "11-50"
  address   String?
  status    String  @default("ACTIVE") // ACTIVE, CHURNED, LEAD

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  ownedProperties Property[] @relation("PropertyOwnerAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("accounts")
}

model Deal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title    String
  value    Float  @default(0)
  currency String @default("COP")

  // Dynamic Pipeline & Stage relationships
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Restrict)

  order Float @default(0) // Position within the stage for Kanban ordering

  probability       Int       @default(10) // 0-100%
  expectedCloseDate DateTime?

  // Sales analytics
  lostReason String? // Why the deal was lost (e.g. "Precio", "Competencia", "Sin presupuesto")
  closedAt   DateTime? // When the deal was won or lost

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedDeals", fields: [assignedToId], references: [id])

  activities   Activity[]
  properties   Property[]
  dealProducts DealProduct[]
  quotations   Quotation[]
  stageHistory DealStageHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🗑️ SOFT DELETE (GDPR Compliance)
  deletedAt DateTime?
  deletedBy String? // User ID who deleted this deal

  // Performance indexes for multi-tenant queries
  @@index([companyId, pipelineId, stageId])
  @@index([stageId, order]) // For Kanban board ordering
  @@index([assignedToId, stageId])
  // For: Soft delete filtering
  @@index([companyId, deletedAt])
  @@map("deals")
}

model Activity {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type        ActivityType @default(NOTE)
  subject     String
  description String?
  status      String       @default("PENDING") // PENDING, COMPLETED
  dueDate     DateTime?

  googleEventId  String? // Store Google Calendar Event ID
  outlookEventId String? // Store Outlook Calendar Event ID

  // Relations (Polymorphic-ish)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedActivities", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedActivities", fields: [createdById], references: [id])

  participants User[] @relation("ActivityParticipants")

  // 💬 @Mentions Support (for Internal Notes collaboration)
  mentions User[] @relation("ActivityMentions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("activities")
}

