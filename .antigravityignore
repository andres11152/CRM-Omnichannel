# .antigravityignore
# -----------------------------------------------------------------------------
# Configuration file for Antigravity AI Agent workspace indexing.
# This file prevents large, auto-generated, binary, or sensitive files from
# being indexed by the AI, significantly reducing token consumption and
# preventing search clutter.
# -----------------------------------------------------------------------------

# --- 1. Dependencies ---
node_modules/
**/node_modules/

# --- 2. Build & Compilations Outputs ---
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
**/ .next/
.nuxt/
**/ .nuxt/
dist-ssr/
**/dist-ssr/

# --- 3. Package Manager Lockfiles (Massive Token Wasters) ---
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# --- 4. Secrets, Configuration & Environment ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.pfx

# --- 5. CRM & WhatsApp Integrations (Local Auth Storage & Sessions) ---
baileys_auth_info/
**/baileys_auth_info/

# --- 6. Media Uploads & Assets ---
uploads/
**/uploads/
temp/
**/temp/

# --- 7. Heavy Media & Binary Assets (Global Extensions) ---
# Images
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.tiff
*.bmp
# Fonts
*.woff
*.woff2
*.eot
*.ttf
*.otf
# Documents
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
# Audio & Video
*.mp3
*.mp4
*.wav
*.webm
*.avi
*.mov
*.mkv
# Archives / Compressed files
*.zip
*.tar.gz
*.tar
*.gz
*.rar
*.7z
# SQLite databases
*.db
*.sqlite
*.sqlite3

# --- 8. System & Editor Cache Files ---
.DS_Store
Thumbs.db
.vscode/
**/ .vscode/
!.vscode/extensions.json
.idea/
**/ .idea/
*.suo
*.ntvs*
