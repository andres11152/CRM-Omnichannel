// ============================================
// REAL ESTATE / PROPERTIES MODULE (Colombia)
// ============================================

enum PropertyOperation {
  VENTA
  ARRIENDO
  ARRIENDO_VENTA
  PERMUTA
}

enum PropertyKind {
  APARTAMENTO
  CASA
  APARTAESTUDIO
  CASA_CAMPESTRE
  LOCAL_COMERCIAL
  OFICINA
  BODEGA
  CONSULTORIO
  LOTE
  FINCA
  PARQUEADERO
  HABITACION
  EDIFICIO
  OTRO
}

enum PropertyStatus {
  DISPONIBLE
  RESERVADO
  ARRENDADO
  VENDIDO
  SUSPENDIDO
  BORRADOR
}

enum PropertyCondition {
  NUEVO
  USADO
  SOBRE_PLANOS
  EN_CONSTRUCCION
  REMODELADO
}

enum PropertyPowerType {
  MONOFASICA
  BIFASICA
  TRIFASICA
}

model Property {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Identidad
  reference String // Código interno autogenerado (INM-000123)
  slug      String // Slug para URL pública (único por company)
  publicId  String @default(cuid()) // ID impredecible para la URL pública

  // Clasificación
  operation PropertyOperation
  kind      PropertyKind
  status    PropertyStatus     @default(BORRADOR)
  condition PropertyCondition?

  // Título / descripción
  title       String
  description String?  @db.Text
  highlights  String[] @default([])

  // Precio (COP)
  price              Float
  currency           String  @default("COP")
  adminFee           Float? // Valor administración mensual
  priceIncludesAdmin Boolean @default(false)
  negotiable         Boolean @default(false)
  pricePerM2         Float? // Derivado (price / builtArea)

  // Áreas (m²)
  builtArea   Float?
  privateArea Float?
  lotArea     Float?

  // Distribución
  bedrooms     Int?
  bathrooms    Float? // Permite medios baños (2.5)
  parkingSpots Int?
  floor        Int?
  totalFloors  Int?
  yearBuilt    Int?
  stratum      Int? // Estrato 1-6

  // Ubicación (Colombia)
  country        String  @default("Colombia")
  department     String? // Departamento
  city           String? // Ciudad / Municipio
  neighborhood   String? // Barrio / Zona
  address        String?
  addressVisible Boolean @default(false)
  latitude       Float?
  longitude      Float?
  zipCode        String?

  // Legal / captación
  registryNumber  String? // Matrícula inmobiliaria
  cadastralNumber String? // Cédula catastral
  isExclusive     Boolean   @default(false)
  capturedAt      DateTime?
  commissionPct   Float?

  // Datos comerciales (locales, oficinas, bodegas)
  frontage       Float? // Frente (m)
  depth          Float? // Fondo (m)
  ceilingHeight  Float? // Altura libre (m) — clave en bodegas/locales
  hasLoadingDock Boolean            @default(false) // Muelle de carga
  hasShowcase    Boolean            @default(false) // Vitrina / aviso a la calle
  isCornerLot    Boolean            @default(false) // Esquinero
  hasMezzanine   Boolean            @default(false) // Entrepiso / mezzanine
  powerType      PropertyPowerType? // Acometida eléctrica
  permittedUse   String? // Uso comercial permitido (POT, varía por municipio)

  // ¿Pertenece a un conjunto cerrado / edificio con zonas comunes compartidas?
  // Determina si aplican amenidades de conjunto (portería, piscina, gimnasio…):
  // una CASA puede estar en conjunto cerrado; un LOTE o FINCA nunca lo está.
  isInComplex Boolean @default(false)

  // Amenidades
  features  String[] @default([]) // Del inmueble
  amenities String[] @default([]) // Del conjunto

  // Media
  images         PropertyImage[]
  videoUrl       String?
  virtualTourUrl String?

  // Vínculos CRM
  ownerContactId String?
  ownerContact   Contact? @relation("PropertyOwnerContact", fields: [ownerContactId], references: [id])
  ownerAccountId String?
  ownerAccount   Account? @relation("PropertyOwnerAccount", fields: [ownerAccountId], references: [id])
  assignedToId   String?
  assignedTo     User?    @relation("PropertyAssignedTo", fields: [assignedToId], references: [id])
  dealId         String?
  deal           Deal?    @relation(fields: [dealId], references: [id])

  // Publicación
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  viewsCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🗑️ SOFT DELETE
  deletedAt DateTime?
  deletedBy String?

  @@unique([companyId, slug])
  @@unique([companyId, reference])
  @@index([companyId, status])
  @@index([companyId, operation, kind])
  @@index([companyId, city, neighborhood])
  @@index([companyId, deletedAt])
  @@index([publicId])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String // URL pública S3
  key        String // S3 key (para borrado)
  order      Int      @default(0)
  isCover    Boolean  @default(false)
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  @@index([propertyId, order])
  @@map("property_images")
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
}

model Media {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // File Information
  filename     String // Stored filename (unique)
  originalName String // Original filename from upload
  mimeType     String // MIME type (image/jpeg, audio/mp3, etc.)
  size         Int // File size in bytes
  url          String // Full URL (S3 or local)
  key          String // S3 key or local path

  // Metadata
  type        MediaType // IMAGE, AUDIO, VIDEO, DOCUMENT
  category    String? // Optional category (marketing, support, etc.)
  tags        String[] // Tags for search
  description String? // Optional description

  // Upload Information
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([type])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("media")
}

// ============================================
// CHATBOT FLOWS (Automation Engine)
// ============================================

enum FlowTriggerType {
  KEYWORD // Mensaje contiene palabra clave
  NEW_CONTACT // Nuevo contacto creado
  DEAL_STAGE // Deal cambia de etapa
  TIME_DELAY // Después de X horas/días
  MANUAL // Activado manualmente por agente
}

enum FlowNodeType {
  START // Nodo inicial
  SEND_MESSAGE // Enviar mensaje de texto
  SEND_IMAGE // Enviar imagen
  SEND_VIDEO // Enviar video
  SEND_AUDIO // Enviar audio
  SEND_DOCUMENT // Enviar documento
  ASK_DATA // Solicitar datos al usuario (input)
  CONDITION // Evaluar condición y ramificar
  AI_AGENT // Consultar OpenAI/Gemini
  CREATE_DEAL // Crear deal en el CRM
  UPDATE_CONTACT // Actualizar campos del contacto
  ASSIGN_AGENT // Asignar conversación a agente
  AI_HANDOFF // Transferir a agente humano
  DELAY // Esperar X tiempo
  END // Fin del flujo
}

enum FlowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

// Contact Flow Session (Estado de ejecución por contacto)
model ContactFlowSession {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // 🛡️ UNIFICATION: Link to Workflow (Single Source of Truth)
  flowId String
  flow   Workflow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Current State
  currentNodeId String? // En qué nodo está actualmente (null = terminó)
  isActive      Boolean @default(true)
  isPaused      Boolean @default(false)

  // Variables (respuestas del usuario, datos capturados)
  variables Json @default("{}") // { "nombre": "Juan", "email": "juan@example.com" }

  // Execution History
  visitedNodes String[] @default([]) // IDs de nodos visitados (para debugging)

  // Timestamps
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  pausedAt    DateTime?
  lastStepAt  DateTime  @default(now()) // Última vez que se ejecutó un nodo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, flowId, isActive])
  @@index([companyId, isActive])
  @@index([flowId, isActive])
  @@index([contactId, isActive])
  @@map("contact_flow_sessions")
}

