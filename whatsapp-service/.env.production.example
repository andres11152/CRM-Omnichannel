# ── CONFIGURACIÓN DEL SERVIDOR ──
PORT=4001
NODE_ENV=production
LOG_LEVEL=info
# Asigna límite de memoria a Node en base a la RAM de tu plan de Render (por ejemplo, 1500 para un plan de 2GB)
NODE_OPTIONS="--max-old-space-size=1500"

# ── BASE DE DATOS Y REDIS ──
DATABASE_URL="postgresql://user:password@host:5432/database"
REDIS_URL="redis://user:password@host:6379"

# ── SEGURIDAD (Idéntico al del backend) ──
SESSION_SECRET="CHANGE_THIS_TO_SECURE_RANDOM_STRING"

# ── CONFIGURACIÓN ANTI-BAN DE WHATSAPP (Baileys) ──
WA_ANTIBAN_PRESET=conservative
WA_ANTIBAN_LOGGING=true
WA_ANTIBAN_ENTROPY=true
WA_ANTIBAN_DEAF_TIMEOUT_MS=300000

# ── LÍMITES DE ALMACENAMIENTO EN MEMORIA ──
WA_STORE_MAX_MESSAGES_PER_JID=150
WA_STORE_MAX_CONTACTS=10000
WA_STORE_MAX_CHATS=5000

# ── COLAS Y CONCURRENCIA ──
WA_OUTBOUND_CONCURRENCY=5
WA_SYNC_FULL_HISTORY=false
