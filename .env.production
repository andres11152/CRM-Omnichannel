# --- Production Environment Variables ---

# Application
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://tu-dominio-frontend.com

# Database & Redis (DEBEN SER LAS URLs DE TU PROVEEDOR DE PRODUCCIÓN)
DATABASE_URL="AQUÍ_VA_LA_URL_REAL_DE_TU_BASE_DE_DATOS_DE_PRODUCCIÓN"
REDIS_URL="redis://user:password@host:port"

# Security
JWT_SECRET="ESTE_DEBE_SER_UN_SECRETO_MUY_LARGO_Y_COMPLEJO_GENERADO_ALEATORIAMENTE"
META_VERIFY_TOKEN="TU_TOKEN_DE_VERIFICACION_DE_META_PARA_PRODUCCION"
STRIPE_SECRET_KEY="sk_live_..." # TU LLAVE SECRETA DE STRIPE EN MODO "LIVE"
STRIPE_WEBHOOK_SECRET="whsec_..." # TU WEBHOOK SECRET DE STRIPE EN MODO "LIVE"