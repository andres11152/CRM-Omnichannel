# PRODUCTION ENVIRONMENT VARIABLES
# Copy this to .env in your Render dashboard

# === CORE ===
NODE_ENV=production
PORT=4000

# === DATABASE ===
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# === FRONTEND & BACKEND URLs ===
FRONTEND_URL=https://reply.software
BACKEND_URL=https://api.reply.software

# === JWT & SESSIONS ===
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING
SESSION_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=7d

# === REDIS ===
REDIS_URL=rediss://username:password@host:port

# === AWS S3 ===
STORAGE_PROVIDER=s3
AWS_REGION=us-east-2
S3_BUCKET_NAME=reply-media
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET

# === GOOGLE OAUTH ===
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.reply.software/api/google/callback

# === STRIPE ===
# Use LIVE keys for production
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# === GEMINI AI ===
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# === CORS ===
ALLOWED_ORIGINS=https://reply.software,https://www.reply.software
