// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Define la fuente de datos.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

enum Channel {
  EMAIL
  WHATSAPP
  SMS
  WEB_CHAT
  TELEGRAM
  FACEBOOK_MESSENGER
  INSTAGRAM_DM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ConversationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Conversation {
  id         String             @id @default(cuid())
  subject    String?
  status     ConversationStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  resolvedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ID of the specific channel/session (e.g. WhatsApp phone number or Session ID)
  channelId String?
  // Which channel this conversation belongs to (disambiguates channelId across providers)
  channel   Channel @default(WHATSAPP)

  // 🏢 GROUP CHAT SUPPORT (Enterprise CRM Feature)
  // Distinguishes between individual DMs and group conversations
  isGroup       Boolean @default(false)
  // JSON: { groupName, description, participantCount, groupPicUrl, createdBy, admins[] }
  groupMetadata Json?

  // Relación con participantes (muchos a muchos implícito)
  participants User[] @relation("Participants")

  // Agente asignado
  assignedToId String?
  assignedTo   User?   @relation("AssignedConversations", fields: [assignedToId], references: [id], onDelete: NoAction)

  messages Message[]
  tags     String[]
  tickets  Ticket[]
  emails   Email[]

  queueId String?
  queue   Queue?  @relation(fields: [queueId], references: [id])

  // Relación con Contacto (Cliente)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // Chatbot Flow Sessions
  flowSessions ContactFlowSession[]

  // 🤖 AI Control State (HITL)
  // Determines if AI can respond to this conversation
  aiEnabled              Boolean   @default(true)
  // Tracks when a human last took control (for auto-unmute grace period)
  lastManualIntervention DateTime?

  // 🔴 UNREAD COUNTER (Badge Support)
  unreadCount Int @default(0)

  // 🔄 GROUP SYNC CONTROL
  // Determines if participants of this group should be auto-indexed into CRM
  syncEnabled Boolean @default(false)

  // 📥 INBOX ORGANIZATION (mirrors Baileys chatModify — archive/pin/mute)
  isArchived Boolean   @default(false)
  isPinned   Boolean   @default(false)
  // null = not muted; a timestamp = muted until that time (Baileys mute semantics)
  mutedUntil DateTime?

  // === HIGH-PERFORMANCE COMPOSITE INDEXES ===

  // 🛡️ DATA INTEGRITY
  // Ensure ONE conversation per phone number per company per channel
  // (channel disambiguates channelId across providers, e.g. WhatsApp phone
  // vs Instagram-Scoped ID, preventing cross-channel collisions)
  @@unique([companyId, channelId, channel], name: "conversation_unique_channel")
  // 1. Agent Dashboard: "My Open Conversations" (Most frequent query)
  // Index Scan -> Instant results
  @@index([companyId, assignedToId, status, updatedAt(sort: Desc)])
  // 2. Supervisor View: "All Active Conversations"
  @@index([companyId, status, updatedAt(sort: Desc)])
  // 3. Queue Management: "Unassigned Queue Items"
  @@index([companyId, queueId, status, updatedAt(sort: Desc)])
  // 4. Cursor Pagination (Essential for infinite scroll)
  @@index([companyId, updatedAt(sort: Desc), id(sort: Asc)])
  // 5. Channel Lookup (Prevent duplicates)
  @@index([companyId, channelId])
  @@map("conversations")
}

model Message {
  id String @id @default(cuid())

  // 🔥 PERFORMANCE: Denormalized companyId
  // Allows querying message stats WITHOUT joining Conversation table
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction)

  content   String
  channel   Channel
  direction MessageDirection
  status    String           @default("SENT") // PENDING, QUEUED, SENT, DELIVERED, READ, FAILED
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Remitente del mensaje
  senderId String
  sender   User   @relation("SenderMessages", fields: [senderId], references: [id], onDelete: NoAction)

  metadata  Json? // For attachments, etc.
  reactions MessageReaction[]

  // 🛡️ DATA INTEGRITY: Prevent duplicate processing of same WhatsApp message.
  // Scoped per-company (NOT globally unique): WhatsApp message IDs are client-
  // generated and can collide across two different companies' independent WA
  // sessions in this multi-tenant SaaS. A bare global @unique here meant
  // Company B's createMany/upsert of a colliding ID silently no-op'd or
  // returned Company A's row instead of creating Company B's message.
  whatsappMessageId String?

  // Same idempotency guard as whatsappMessageId above, scoped to Instagram
  // Direct messages (Instagram-assigned message id from the Messaging API).
  instagramMessageId String?

  // Same idempotency guard, scoped to email (the RFC 5322 Message-ID header of
  // the ingested mail) — prevents the IMAP poller from re-ingesting the same
  // email as a duplicate Message on overlapping fetch windows.
  emailMessageId String?

  // === ANALYTICS & HISTORY INDEXES ===

  // 5. Per-company uniqueness for WhatsApp message dedup (see comment above)
  @@unique([companyId, whatsappMessageId])
  // 6. Per-company uniqueness for Instagram message dedup
  @@unique([companyId, instagramMessageId])
  // 6b. Per-company uniqueness for email message dedup
  @@unique([companyId, emailMessageId])
  // 1. Chat History Load: "Get last 50 messages for this chat"
  @@index([conversationId, createdAt(sort: Desc)])
  // 2. Global Analytics: "Messages per day per company" (No JOIN needed!)
  @@index([companyId, createdAt(sort: Desc)])
  // 3. Status Filtering: "Available Limit / Failed Messages"
  @@index([companyId, status, createdAt(sort: Desc)])
  // 4. Sender History
  @@index([senderId, createdAt(sort: Desc)])
  @@map("messages")
}

// ... (User sections skipped, no changes needed there)

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reactBy   String // Phone/JID of the person who reacted
  content   String // The emoji
  createdAt DateTime @default(now())
  companyId String // 🛡️ REQUIRED for multi-tenant isolation

  @@unique([messageId, reactBy]) // Only one emoji per message per person
  @@index([companyId]) // 🛡️ Performance index for tenant-scoped queries
  @@map("message_reactions")
}

model Contact {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  email             String?
  phone             String?
  instagramUserId   String? // Instagram-Scoped ID (IGSID) of the sender
  instagramUsername String? // Display handle, informational only
  avatarUrl         String?
  tags              String[]
  notes             String?
  customFields      Json?
  profilePicUrl     String?
  about             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // [EMAIL] CAN-SPAM / GDPR: contacts who unsubscribed from email campaigns.
  // Enforced at send time in CampaignExecutionService — never bypass this.
  emailOptOut   Boolean   @default(false)
  emailOptOutAt DateTime?

  // 🗑️ SOFT DELETE
  deletedAt DateTime?
  deletedBy String?

  // 🚫 SPAM BLACKLIST (Enterprise Anti-Spam)
  isBlocked     Boolean   @default(false)
  blockedAt     DateTime?
  blockedReason String? // "SPAM", "MANUAL", "ABUSE"

  // CRM Relations
  accountId  String?
  account    Account?   @relation(fields: [accountId], references: [id])
  deals      Deal[]
  activities Activity[]

  emails          Email[]
  flowSessions    ContactFlowSession[]
  conversations   Conversation[]
  ownedProperties Property[]           @relation("PropertyOwnerContact")
  quotations      Quotation[]

  // === SEARCH OPTIMIZATION ===

  // 🛡️ INTEGRITY
  @@unique([companyId, phone])
  @@unique([companyId, instagramUserId])
  // 1. Fast Phone Lookup (WhatsApp Webhook critical path)
  @@index([companyId, phone])
  // 1b. Fast Instagram IGSID Lookup (Instagram Webhook critical path)
  @@index([companyId, instagramUserId])
  // 2. Fast Email Lookup
  @@index([companyId, email])
  // 3. Recent Contacts View (Dashboard / List)
  @@index([companyId, deletedAt, createdAt(sort: Desc)])
  // 4. Name Autocomplete (Prefix search)
  @@index([companyId, name])
  // 5. Blocked Contact Lookup (Critical for Spam Gate on incoming messages)
  @@index([companyId, phone, isBlocked])
  @@map("contacts")
}

// --- Modelos de Autenticación y SaaS Multi-Tenant ---

enum UserRole {
  USER
  AGENT
  SUPERVISOR
  ADMIN
  MASTER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  TRIAL
  OVERDUE
  CANCELED
  BANNED
}

model Company {
  id                 String        @id @default(cuid())
  name               String
  slug               String?       @unique
  logoUrl            String?
  status             CompanyStatus @default(TRIAL)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  subscriptionEndsAt DateTime?

  // Enhanced Profile Fields
  address  String?
  phone    String?
  website  String?
  timezone String  @default("UTC")

  // JSON Settings (Business Hours, Auto-Replies, etc.)
  settings Json? @default("{}")

  // SMTP Configuration (Multi-Tenant Email)
  emailProvider      String  @default("SMTP") // SMTP, SENDGRID, AWS_SES
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPassword       String? // Encrypted
  smtpSecure         Boolean @default(true)
  defaultSenderEmail String?
  defaultSenderName  String?

  // IMAP Configuration (inbound email → tickets). Mirrors the SMTP block above.
  // When emailInboundEnabled + creds are set, the email poller ingests new mail
  // as EMAIL-channel conversations/tickets (see EmailInboundService).
  imapHost            String?
  imapPort            Int?
  imapUser            String?
  imapPassword        String? // Encrypted (same mechanism as smtpPassword)
  imapSecure          Boolean   @default(true)
  emailInboundEnabled Boolean   @default(false)
  // Incremental fetch cursor so the poller never reprocesses old mail.
  imapLastSeenUid     Int?
  imapLastSeenAt      DateTime?

  // Relaciones
  users             User[]
  agentSessions     AgentSession[]
  tickets           Ticket[]
  apiKeys           ApiKey[]
  conversations     Conversation[]
  whatsappSessions  WhatsAppSession[]
  instagramSessions InstagramSession[]
  departments       Department[]
  queues            Queue[]
  campaigns         Campaign[]
  tags              Tag[]
  workflows         Workflow[]
  media             Media[]
  accounts          Account[]
  deals             Deal[]
  activities        Activity[]
  contacts          Contact[]
  messageTemplates  MessageTemplate[]
  aiConfig          AIConfig?
  aiAssistants      AIAssistant[]
  quickReplies      QuickReply[]
  pipelines         Pipeline[] // CRM Pipelines
  products          Product[] // Product Catalog
  properties        Property[] // Real Estate Module
  dealProducts      DealProduct[]
  quotations        Quotation[]
  dealStageHistory  DealStageHistory[]

  // Chatbot Flows
  // Link to 'workflows' is the single source of truth (line 251)
  // Cleaned up deprecated 'flows' reference.

  flowSessions ContactFlowSession[]

  // Multimedia Library
  mediaAssets MediaAsset[]

  // Email Module
  emails Email[]

  // Billing & Trial Management
  trialEndsAt   DateTime?
  planExpiresAt DateTime?

  // Relación con Stripe y Planes
  planId               String?
  plan                 Plan?   @relation(fields: [planId], references: [id])
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Push Notifications
  pushSubscriptions PushSubscription[]

  // RBAC - Custom Roles
  roles              Role[]
  Message            Message[]
  notifications      Notification[]
  transactions       BillingTransaction[]
  workflowExecutions WorkflowExecution[]
  meetingTypes       MeetingType[]
  availabilities     Availability[]

  @@map("companies")
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String?
  phone    String? // Added for WhatsApp Integration support
  password String
  role     UserRole @default(AGENT)

  // WFM Fields
  maxConcurrency Int      @default(3)
  skills         String[]

  // Security
  isOwner Boolean @default(false)

  preferences   Json?
  profilePicUrl String? // WhatsApp Profile Pic
  about         String? // WhatsApp Status/About info
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Activity Tracking
  lastSeen      DateTime?
  isOnline      Boolean        @default(false)
  agentSessions AgentSession[]

  // Relación con Compañía (Tenant)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relaciones del foro/blog
  posts   Post[] // Posts creados por el usuario
  replies Reply[] // Respuestas creadas por el usuario

  // Relaciones de Tickets
  createdTickets  Ticket[] @relation("CreatedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")

  // Relaciones de Conversaciones (Mensajería)
  sentMessages          Message[]      @relation("SenderMessages") // Mensajes que el usuario envió
  assignedConversations Conversation[] @relation("AssignedConversations") // Conversaciones asignadas al agente
  conversations         Conversation[] @relation("Participants") // Conversaciones donde participa

  // Relaciones de Colas
  queues Queue[] @relation("QueueAgents")

  // Relaciones de Media
  uploadedMedia Media[]

  // CRM Relations
  assignedDeals           Deal[]             @relation("AssignedDeals")
  dealStageChanges        DealStageHistory[]
  assignedProperties      Property[]         @relation("PropertyAssignedTo")
  assignedActivities      Activity[]         @relation("AssignedActivities")
  createdActivities       Activity[]         @relation("CreatedActivities")
  participatingActivities Activity[]         @relation("ActivityParticipants")
  mentionedInActivities   Activity[]         @relation("ActivityMentions")
  createdQuotations       Quotation[]        @relation("CreatedQuotations")

  // Chatbot Flows
  // createdFlows Workflow[] -- No relation defined in Workflow model for 'createdBy' user yet??
  // Checking Workflow model... no createdById.
  // So 'createdFlows' in User model has no counterpart.
  // We should REMOVE this line until we add createdById to Workflow.
  // Or, if we want to keep it future-proof, add createdById to Workflow OR just comment it out.
  // Given the error P1012, removing the invalid type reference is the fix.
  // createdFlows Flow[] -- REMOVED due to invalid type "Flow"

  // Campaigns
  createdCampaigns Campaign[]

  // Multimedia Library
  uploadedMediaAssets MediaAsset[]

  // Google Calendar Integration
  googleCalendarToken        String? // Access token
  googleCalendarRefreshToken String? // Refresh token for long-term access

  // Outlook Calendar Integration
  outlookCalendarToken        String?
  outlookCalendarRefreshToken String?

  // Password Reset
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // Push Notifications
  pushSubscriptions PushSubscription[]

  // In-app Notifications
  notifications Notification[]

  // RBAC - Custom Role
  customRoleId String?
  customRole   Role?   @relation("UserRole", fields: [customRoleId], references: [id], onDelete: SetNull)

  meetingTypes MeetingType[]
  availability Availability?

  // For: Email lookup is already covered by @unique

  // === PERFORMANCE INDEXES ===
  // For: Get users by company and role (very common)
  @@index([companyId, role, createdAt(sort: Desc)])
  @@map("users")
}

model Workflow {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean @default(true)
  isGlobal    Boolean @default(false)

  triggerType   String @default("KEYWORD") // KEYWORD, EVENT
  triggerConfig Json? // { keyword: "hola" } or { event: "DEAL_UPDATE" }

  nodes Json?
  edges Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions   WorkflowExecution[]
  flowSessions ContactFlowSession[]

  @@map("workflows")
}

model WorkflowExecution {
  id         String   @id @default(cuid())
  companyId  String? // 🛡️ Denormalized for native RLS and high-performance querying
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  logs        Json?
  error       String?

  // === HIGH-PERFORMANCE ANALYTICS INDEXES ===
  // 1. Audit Dashboard: "Latest executions for this company"
  @@index([companyId, startedAt(sort: Desc)])
  // 2. Health Monitor: "Find failed executions for Workflow X"
  @@index([workflowId, status, startedAt(sort: Desc)])
  // 3. Execution History Search
  @@index([companyId, workflowId, status, startedAt(sort: Desc)])
  @@map("workflow_executions")
}

enum WhatsAppProvider {
  BAILEYS
  META
}

model WhatsAppSession {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessionId   String  @unique // Folder name for auth creds
  phone       String?
  status      String  @default("DISCONNECTED") // CONNECTED, DISCONNECTED, SCANNING
  qrCode      String? // Base64 QR for frontend display
  proxyUrl    String? // Proxy URL to route session traffic (avoid shared IP bans)
  profileName String?

  // Notification tracking
  notifiedAt DateTime? // Last time we notified about disconnection

  // Provider configuration
  provider          WhatsAppProvider @default(BAILEYS)
  metaAccessToken   String?
  metaPhoneNumberId String?
  metaBusinessId    String?
  metaVerifyToken   String?

  // Custom Default Queue for this Session
  defaultQueueId String?
  defaultQueue   Queue?  @relation(fields: [defaultQueueId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === PERFORMANCE INDEXES ===
  // For: Get sessions by company and status
  @@index([companyId, status, createdAt(sort: Desc)])
  @@map("whatsapp_sessions")
}

model InstagramSession {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  igBusinessAccountId String  @unique // Instagram-Scoped Business Account ID (IG User ID)
  pageId              String // Linked Facebook Page ID (required by the Send API)
  accessToken         String // Page access token with instagram_manage_messages scope
  verifyToken         String // Webhook verify token (shown to admin to paste into Meta App dashboard)
  username            String? // Display handle, informational only

  status String @default("DISCONNECTED") // CONNECTED, DISCONNECTED

  // Custom Default Queue for this Session
  defaultQueueId String?
  defaultQueue   Queue?  @relation(fields: [defaultQueueId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@map("instagram_sessions")
}

model WhatsAppCredential {
  id        String   @id @default(cuid())
  sessionId String
  key       String // The key (e.g., "creds", "app-state-sync-key-aaaa")
  value     String // JSON stringified value
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, key])
  @@map("whatsapp_credentials")
}

model AgentSession {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  duration       Int? // Duration in seconds

  socketId String? // Useful for debugging specific socket drops

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === ANALYTICS INDEXES ===
  // 1. Durations per user per day ("How long did Cheo work today?")
  @@index([userId, connectedAt])
  // 2. Company-wide usage reports ("Total agent hours this month")
  @@index([companyId, connectedAt])
  @@map("agent_sessions")
}

model Plan {
  id     String @id @unique
  name   String
  price  Float
  config Json // { max_users: number; max_queues: number; }

  // Quotas (Strict Limits)
  storageLimitGb Float? // GB allowed. Null = Unlimited
  maxContacts    Int? // Max contacts. Null = Unlimited
  maxCompanies   Int? // Max sub-companies/accounts. Null = Unlimited
  maxWorkflows   Int? // Max active workflows. Null = Unlimited

  companies Company[]

  @@map("plans")
}

model ApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique // Hash de la clave, nunca la clave en texto plano
  keyPrefix  String // Prefijo no sensible para identificación (ej. "sk_live_...")
  name       String // Un nombre descriptivo dado por el usuario
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scopes     String[]  @default(["*"]) // e.g. ["contacts:read", "messages:write"]
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // Opcional: para rastrear el uso

  @@map("api_keys")
}

model ApiAccessLog {
  id         String   @id @default(cuid())
  companyId  String
  apiKeyId   String? // Optional because key might be deleted
  endpoint   String
  method     String
  statusCode Int
  ipAddress  String?
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@map("api_access_logs")
}

model Webhook {
  id          String   @id @default(cuid())
  companyId   String
  url         String
  description String?
  secretKey   String?
  events      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveryLogs WebhookDeliveryLog[]

  @@index([companyId, isActive])
  @@map("webhooks")
}

model WebhookDeliveryLog {
  id        String   @id @default(cuid())
  companyId String
  webhookId String
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType String
  url       String // Denormalized for fast log queries
  status    Int // HTTP status code (200, 500, etc.)
  duration  Int // Response time in milliseconds
  error     String? // Error message if delivery failed
  payload   Json? // The event payload sent (for debugging)
  attempt   Int      @default(1) // Retry attempt number
  createdAt DateTime @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@index([webhookId, createdAt(sort: Desc)])
  @@map("webhook_delivery_logs")
}

// --- Modelos del Foro/Blog ---

model Post {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  replies Reply[]

  @@map("posts")
}

model Reply {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: NoAction)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("replies")
}

// --- Modelos de Soporte (Tickets) ---

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketResolutionType {
  SALE
  SUPPORT
  ADMIN
  OTHER
  SPAM
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber Int // Sequential number per company (e.g. 1, 2, 3...)
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)

  // Resolution fields
  resolutionType  TicketResolutionType?
  resolutionNotes String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  // 🗑️ SOFT DELETE (GDPR Compliance)
  deletedAt DateTime?
  deletedBy String? // User ID who deleted this ticket

  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User    @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: NoAction)
  assignedToId String?
  assignedTo   User?   @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: NoAction)

  queueId String?
  queue   Queue?  @relation(fields: [queueId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  // Email timeline
  emails Email[]

  // === PERFORMANCE INDEXES ===
  // For: Get tickets by company and status (dashboard query)
  @@index([companyId, status, createdAt(sort: Desc)])
  // For: Soft delete filtering (critical for GDPR compliance)
  @@index([companyId, deletedAt])
  // For: Get tickets by assignee
  @@index([assignedToId, status, createdAt(sort: Desc)])
  // For: Get tickets by queue
  @@index([queueId, status, createdAt(sort: Desc)])
  // For: Get tickets by priority for sorting
  @@index([companyId, priority, status, createdAt(sort: Desc)])
  @@map("tickets")
}

enum QueueType {
