{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for Sentry",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "npx rimraf dist && tsc",
    "start": "node --expose-gc --max-old-space-size=${NODE_MAX_OLD_SPACE_MB:-2048} -r module-alias/register dist/server.js",
    "start:worker": "node --expose-gc --max-old-space-size=${NODE_MAX_OLD_SPACE_MB:-2048} -r module-alias/register dist/worker.js",
    "start:all": "npx pm2 start ecosystem.config.json",
    "test": "jest",
    "lint": "eslint src/**",
    "lint:strict": "eslint src/** --max-warnings=0",
    "prisma:dev": "npx prisma migrate dev",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "postinstall": "npx prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "npx ts-node prisma/seed.ts"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
