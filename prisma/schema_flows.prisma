
// ============================================
// CHATBOT FLOWS (Automation Engine)
// ============================================

enum FlowTriggerType {
  KEYWORD      // Mensaje contiene palabra clave
  NEW_CONTACT  // Nuevo contacto creado
  DEAL_STAGE   // Deal cambia de etapa
  TIME_DELAY   // Después de X horas/días
  MANUAL       // Activado manualmente por agente
}

enum FlowNodeType {
  START          // Nodo inicial
  SEND_MESSAGE   // Enviar mensaje de texto
  SEND_IMAGE     // Enviar imagen
  SEND_VIDEO     // Enviar video
  SEND_AUDIO     // Enviar audio
  SEND_DOCUMENT  // Enviar documento
  ASK_DATA       // Solicitar datos al usuario (input)
  CONDITION      // Evaluar condición y ramificar
  AI_AGENT       // Consultar OpenAI/Gemini
  CREATE_DEAL    // Crear deal en el CRM
  UPDATE_CONTACT // Actualizar campos del contacto
  ASSIGN_AGENT   // Asignar conversación a agente
  AI_HANDOFF     // Transferir a agente humano
  DELAY          // Esperar X tiempo
  END            // Fin del flujo
}

enum FlowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Flow {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      FlowStatus @default(DRAFT)

  // Flow Structure (JSON from React Flow)
  nodes Json // Array of nodes with {id, type, data, position}
  edges Json // Array of edges with {id, source, target, sourceHandle?, targetHandle?}

  // Trigger Configuration
  triggerType FlowTriggerType
  triggerData Json? // Extra config (keywords, delay time, etc.)

  // Settings
  isActive Boolean @default(false)
  priority Int     @default(0) // Higher priority flows execute first

  // Stats
  executionCount Int @default(0) // Cuántas veces se ha ejecutado
  completionRate Float @default(0) // % de usuarios que completan el flujo

  // Relations
  sessions ContactFlowSession[]

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([triggerType])
  @@map("flows")
}

// Contact Flow Session (Estado de ejecución por contacto)
model ContactFlowSession {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  flowId String
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Current State
  currentNodeId String? // En qué nodo está actualmente (null = terminó)
  isActive      Boolean @default(true)
  isPaused      Boolean @default(false)

  // Variables (respuestas del usuario, datos capturados)
  variables Json @default("{}") // { "nombre": "Juan", "email": "juan@example.com" }

  // Execution History
  visitedNodes String[] @default([]) // IDs de nodos visitados (para debugging)
  
  // Timestamps
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  pausedAt    DateTime?
  lastStepAt  DateTime  @default(now()) // Última vez que se ejecutó un nodo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, flowId, isActive])
  @@index([companyId, isActive])
  @@index([flowId, isActive])
  @@index([contactId, isActive])
  @@map("contact_flow_sessions")
}
